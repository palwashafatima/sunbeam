<!doctype html>

<html lang="en">

<head>

<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">

<title>POUR & TELL — Coffee × Matcha</title>

<style>

:root{--cream:#fbf6ec;--ink:#263026;--green:#718b68;--mint:#e3eddc;--tan:#eadcc8;--pink:#f0d9d5}

*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--cream);color:var(--ink);font-family:Inter,system-ui,sans-serif}

nav{position:sticky;top:0;z-index:5;background:#fbf6ecef;backdrop-filter:blur(12px);border-bottom:1px solid #ded8ca;padding:16px 5vw;display:flex;justify-content:space-between;align-items:center}

.logo{font-weight:900;letter-spacing:.12em}.navlinks a{margin-left:20px;color:var(--ink);text-decoration:none;font-size:14px;font-weight:700}

section{max-width:1100px;margin:auto;padding:75px 5vw}.hero{text-align:center;min-height:82vh;display:flex;flex-direction:column;justify-content:center}

.badge{display:inline-block;margin:auto;background:var(--mint);padding:9px 15px;border-radius:999px;font-size:12px;font-weight:800;letter-spacing:.08em}

h1{font-size:clamp(48px,9vw,100px);line-height:.9;letter-spacing:-.07em;margin:25px 0}.hero p{max-width:650px;margin:0 auto 25px;color:#687067;font-size:18px;line-height:1.6}

.cta{display:inline-block;background:var(--ink);color:white;text-decoration:none;padding:15px 24px;border-radius:999px;font-weight:800}

h2{font-size:clamp(34px,6vw,60px);letter-spacing:-.05em;margin:0 0 14px}.lead{color:#697067;max-width:650px;line-height:1.6}

.card{background:#fffdf8;border:1px solid #e3ddd1;border-radius:30px;padding:30px;box-shadow:0 15px 45px #39352a12}

.progress{height:8px;background:#e8e1d5;border-radius:99px;overflow:hidden;margin-bottom:25px}.bar{height:100%;width:10%;background:var(--green);transition:.35s}

.q{font-size:25px;font-weight:850}.choices{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}

button{border:0;border-radius:18px;padding:18px;background:#eee9df;color:var(--ink);font-size:16px;font-weight:750;cursor:pointer;transition:.2s}button:hover{transform:translateY(-3px);background:var(--mint)}

#result{display:none;text-align:center}.resultemoji{font-size:70px}.resulttitle{font-size:42px;font-weight:900;margin:8px}

.stats{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin:20px}.tag{background:var(--mint);padding:8px 13px;border-radius:99px;font-size:13px;font-weight:800}

.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:30px}.fact{border-radius:26px;padding:24px;min-height:210px}.fact:nth-child(1){background:var(--mint)}.fact:nth-child(2){background:var(--tan)}.fact:nth-child(3){background:var(--pink)}

.fact p{line-height:1.55;color:#5f645d}

.tablewrap{overflow-x:auto;margin-top:25px}.compare{width:100%;border-collapse:separate;border-spacing:0;background:#fffdf8;border:1px solid #e1dbcf;border-radius:25px;overflow:hidden;min-width:650px}.compare th,.compare td{text-align:left;padding:18px;border-bottom:1px solid #e9e3d8}.compare th{background:#e9f0e5}.compare tr:last-child td{border-bottom:0}.price{font-weight:900}.brand{font-size:20px;font-weight:900}

.filters{display:flex;gap:10px;flex-wrap:wrap;margin:20px 0}.filter.active{background:var(--ink);color:white}

#random{background:var(--ink);color:white;border-radius:28px;padding:25px;margin-top:25px}.small{font-size:13px;color:#777}.disclaimer{font-size:12px;color:#777;line-height:1.5;margin-top:15px}

footer{text-align:center;padding:50px;color:#777;font-size:13px}

@media(max-width:700px){.choices,.grid{grid-template-columns:1fr}.navlinks{display:none}section{padding-top:55px}}

</style>

</head>

<body>

<nav><div class="logo">POUR & TELL</div><div class="navlinks"><a href="#quiz">QUIZ</a><a href="#brands">BRANDS</a><a href="#culture">CULTURE</a></div></nav>


<section class="hero">

<span class="badge">KARACHI • COFFEE • MATCHA • OPINIONS</span>

<h1>What's<br>your pour?</h1>

<p>Part personality quiz. Part Karachi café guide. Part extremely serious investigation into whether matcha actually tastes like grass.</p>

<a class="cta" href="#quiz">Find my drink ↓</a>

</section>


<section id="quiz">

<h2>The drink interrogation.</h2><p class="lead">No wrong answers. Just vibes, habits and questionable café decisions.</p>

<div class="card">

<div class="progress"><div class="bar" id="bar"></div></div>

<div id="quizbox"><p class="q" id="question"></p><div class="choices" id="choices"></div></div>

<div id="result"><div class="resultemoji" id="icon"></div><div class="resulttitle" id="title"></div><p id="desc" class="lead" style="margin:auto"></p><div class="stats" id="stats"></div><button onclick="restart()">Do it again ↻</button></div>

</div>

</section>


<section id="brands">

<h2>Three pours, one question.</h2><p class="lead">A quick snapshot of three Pakistan/Karachi coffee names. Prices can vary by branch, size, promotions and delivery platform.</p>

<div class="filters"><button class="filter active" onclick="showBrand('all',this)">All</button><button class="filter" onclick="showBrand('melbrew',this)">Melbrew</button><button class="filter" onclick="showBrand('luna',this)">Luna</button><button class="filter" onclick="showBrand('drop',this)">Drop</button></div>

<div class="tablewrap"><table class="compare"><thead><tr><th>Brand</th><th>Hot coffee</th><th>Popular / specialty</th><th>Menu vibe</th></tr></thead><tbody id="brandrows"></tbody></table></div>

<p class="disclaimer">Prices shown are approximate/current menu snapshots, not permanent price guarantees. Melbrew and Luna figures come from their listed online menus; Drop figures are from a current Karachi delivery menu.</p>

</section>


<section id="culture">

<h2>Okay, but why do we drink it?</h2>

<div class="grid">

<div class="fact"><h3>☕ The social drink</h3><p>In Karachi, cafés can be study rooms, hangout spots, meeting places and photo backdrops. The drink becomes part of the experience.</p></div>

<div class="fact"><h3>⚡ The caffeine effect</h3><p>Caffeine can increase alertness. Too much can also leave some people feeling jittery or interfere with sleep—so “stronger” isn't automatically better.</p></div>

<div class="fact"><h3>🌿 The grass debate</h3><p>Matcha really can taste earthy or grassy. Its flavour changes with quality, preparation and what it is mixed with. Coffee fans are allowed to remain unconvinced.</p></div>

</div>

<div id="random"><b>RANDOM POUR ✦</b><p id="facttext">Karachi café culture is as much about the ritual as the drink.</p><button onclick="randomFact()">Give me another →</button></div>

</section>


<footer>Made for a hackathon ✦ POUR & TELL</footer>


<script>

const qs=[

["Your first move at a café?","Study immediately","Take 14 photos","Read the whole menu","Ask everyone what they're getting"],

["Pick a flavour","Chocolate + caramel","Earthy + creamy","Sweet + vanilla","Something experimental"],

["Your caffeine relationship?","I need a boost","I like the ritual","I barely notice it","It owns me"],

["Choose a weather","Rainy window","Sunny afternoon","Cold evening","Karachi summer survival"],

["Matcha tastes like…","Grass 🌿","Dessert","An acquired taste","Actually amazing"],

["Your ideal café energy","Quiet & focused","Cute & aesthetic","Loud & chaotic","Deep conversation"],

["Pick a personality","Reliable","Curious","Extra","Unpredictable"],

["What matters most?","Taste","Presentation","Price","Vibes"],

["Your order size?","Small & strong","Big & iced","Whatever looks good","Depends on my mood"],

["Final question: coffee or matcha?","COFFEE ☕","MATCHA 🍵","BOTH","Surprise me"]

];

let step=0,score={coffee:0,matcha:0,chaos:0};

function render(){question.textContent=qs[step][0];choices.innerHTML=qs[step].slice(1).map((x,i)=>`<button onclick="pick(${i})">${x}</button>`).join("");bar.style.width=((step+1)/qs.length*100)+"%"}

function pick(i){if(i===0)score.coffee+=2;if(i===1)score.matcha+=2;if(i===2)score.chaos+=2;if(i===3){score.chaos++;score.coffee++}if(step===4&&i===0)score.coffee++;if(step===9&&i===0)score.coffee+=3;if(step===9&&i===1)score.matcha+=3;if(step<qs.length-1){step++;render()}else finish()}

function finish(){quizbox.style.display="none";result.style.display="block";let w=Object.entries(score).sort((a,b)=>b[1]-a[1])[0][0];let d={coffee:["☕","THE COFFEE CORE","Bold, comforting and probably carrying a café loyalty card.","Espresso energy","Classic taste"],matcha:["🍵","THE MATCHA MIND","Curious, aesthetic and completely willing to defend green drinks.","Earthy vibes","Tea energy"],chaos:["🌀","THE CAFÉ WILDCARD","You don't choose drinks. Drinks choose you.","Experimental","Vibes first"]}[w];icon.textContent=d[0];title.textContent=d[1];desc.textContent=d[2];stats.innerHTML=d.slice(3).map(x=>`<span class="tag">${x}</span>`).join("")}

function restart(){step=0;score={coffee:0,matcha:0,chaos:0};result.style.display="none";quizbox.style.display="block";render()}

const brands={

melbrew:{name:"Melbrew",hot:"Rs. 470+ (Americano / Espresso)",special:"Pistachio Latte Rs. 720 • Mint Mocha Rs. 780",vibe:"Specialty + flavoured coffees"},

luna:{name:"Luna",hot:"Rs. 675+ (Espresso)",special:"Spanish Latte Rs. 910 • Maple Cinnamon Raf Rs. 1,260",vibe:"Premium / specialty"},

drop:{name:"Drop",hot:"Rs. 545+ (Latte)",special:"Iced Spanish Latte Rs. 695 • Tiramisu Frappe Rs. 800",vibe:"Broad, playful, value-focused"}

};

function showBrand(type,btn){document.querySelectorAll(".filter").forEach(x=>x.classList.remove("active"));btn.classList.add("active");brandrows.innerHTML=Object.entries(brands).filter(([k])=>type==="all"||k===type).map(([k,b])=>`<tr><td class="brand">${b.name}</td><td class="price">${b.hot}</td><td>${b.special}</td><td>${b.vibe}</td></tr>`).join("")}

const facts=["Matcha is powdered green tea, so preparation makes a big difference to flavour.","Coffee can feel energising because caffeine increases alertness.","A drink can be a social ritual, not just a source of caffeine.","The 'matcha tastes like grass' opinion is one of the internet's most enduring beverage debates.","Drop's current menu includes dedicated matcha, iced coffee and frappe categories.","Melbrew's menu includes espresso-based classics plus flavoured specialty drinks.","Luna's listed menu sits at a noticeably higher price point for several classic coffees."];

function randomFact(){facttext.textContent=facts[Math.floor(Math.random()*facts.length)]}

render();showBrand("all",document.querySelector(".filter"));

</script>

</body>

</html>
